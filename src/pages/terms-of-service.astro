---
import Base from "@/components/store/layout/Base.astro";
import InfoPageHeader from "@/components/store/ui/InfoPageHeader.astro";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import termsMarkdown from "@/data/terms-of-service.md?raw";
import { marked } from "marked";

const termsHtml = await marked.parse(termsMarkdown);
---

<Base title="Terms of Service | SVG Piggies">
  <MaxWidthContainer narrow>
    <InfoPageHeader label="terms of service" />
    <article class="prose prose-lg prose-headings:text-foreground prose-a:text-primary w-full" set:html={termsHtml} />
  </MaxWidthContainer>
</Base>
