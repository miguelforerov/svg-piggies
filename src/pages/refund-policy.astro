---
import Base from "@/components/store/layout/Base.astro";
import InfoPageHeader from "@/components/store/ui/InfoPageHeader.astro";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import refundMarkdown from "@/data/refund-policy.md?raw";
import { marked } from "marked";

const refundHtml = await marked.parse(refundMarkdown);
---

<Base title="Refund Policy | SVG Piggies">
  <MaxWidthContainer narrow>
    <InfoPageHeader label="refund policy" />
    <article class="prose prose-lg prose-headings:text-foreground prose-a:text-primary w-full" set:html={refundHtml} />
  </MaxWidthContainer>
</Base>
