---
import Base from "@/components/store/layout/Base.astro";
import InfoPageHeader from "@/components/store/ui/InfoPageHeader.astro";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import privacyMarkdown from "@/data/privacy-policy.md?raw";
import { marked } from "marked";

const privacyHtml = await marked.parse(privacyMarkdown);
---

<Base title="Privacy Policy | SVG Piggies">
  <MaxWidthContainer narrow>
    <InfoPageHeader label="privacy policy" />
    <article class="prose prose-lg prose-headings:text-foreground prose-a:text-primary w-full" set:html={privacyHtml} />
  </MaxWidthContainer>
</Base>
