---
import Base from "@/components/store/layout/Base.astro";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { AddToCart } from "@/components/store/cart/AddToCart";
import ProductGalery from "@/components/store/product/ProductGallery";
import SocialShare from "@/components/store/ui/SocialShare";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import { getCatalog, getProductBySlug } from "@/lib/catalog";
import ProductFeature from "@/components/store/ui/ProductFeature.astro";
import FileType from "@/components/store/ui/FileType.astro";
import Price from "@/components/store/product/Price"
import RelatedProductsSlider from "@/components/store/product/RelatedProductsSlider"
import { Separator } from "@/components/ui/separator"
import type { Product } from "@/types/product";

export const prerender = false;

const slug = Astro.params.slug;
let loadError: string | null = null;
let product = null;

if (slug) {
  try {
    product = await getProductBySlug(slug, Astro.request.headers);
  } catch (error) {
    console.error(`Unable to load product ${slug}:`, error);
    loadError = error instanceof Error ? error.message : "Unable to load product";
  }
}

if (!product && !loadError) {
  Astro.response.status = 404;
}

if (loadError) {
  Astro.response.status = 502;
}

const galleryImages = product
  ? product.images.length > 0
    ? product.images.map((image) => ({
        url: image.url,
        altText: product.title,
        width: 800,
        height: 800,
      }))
    : [
        {
          url: "/images/product-placeholder.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/product-placeholder.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/product-placeholder.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/product-placeholder.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
      ]
  : [];

// Keep the temporary gallery images available to components that read product.images.
if (product && product.images.length === 0) {
  product.images = galleryImages.map((image, displayOrder) => ({
    id: `${product.id}-placeholder-${displayOrder}`,
    url: image.url,
    displayOrder,
  }));
}

let relatedProducts: Product[] = [];

if (product) {
  try {
    const { products } = await getCatalog(Astro.request.headers);
    const current = products.find((item) => item.id === product.id);
    const collectionIds = new Set(current?.collections.map((item) => item.id) ?? []);
    const productTypeIds = new Set(current?.productTypes.map((item) => item.id) ?? []);
    const otherProducts = products.filter((item) => item.id !== product.id);
    const sharesCollectionOrType = (item: (typeof products)[number]) =>
      item.collections.some((collection) => collectionIds.has(collection.id)) ||
      item.productTypes.some((type) => productTypeIds.has(type.id));

    relatedProducts = [
      ...otherProducts.filter(sharesCollectionOrType),
      ...otherProducts.filter((item) => !sharesCollectionOrType(item)),
    ].slice(0, 8);
  } catch (error) {
    console.error(`Unable to load related products for ${slug}:`, error);
  }
}


/*
 * TODO(product-detail): hydrate real image metadata once a GET images endpoint
 * exists, and replace the catalog lookup above with a public related-products endpoint.
 * Sale price and variants remain documented for their future domain support.
 */
---

<Base title={product ? `${product.title} | SVG Piggies` : "Product | SVG Piggies"}>
  {
    loadError ? (
      <section class="section">
        <div class="container text-center">
          <h1 class="h2 mb-4">Product unavailable</h1>
          <p>We could not load this product. Please try again later.</p>
          <a class="btn btn-primary mt-6" href="/products">Back to products</a>
        </div>
      </section>
    ) : !product ? (
      <section class="section">
        <div class="container text-center">
          <h1 class="h2 mb-4">Product not found</h1>
          <p>The requested product does not exist or is not active.</p>
          <a class="btn btn-primary mt-6" href="/products">Back to products</a>
        </div>
      </section>
    ) : (
      <MaxWidthContainer>
        <div class="w-full">
          <Breadcrumb>
            <BreadcrumbList>
              <BreadcrumbItem>
                <BreadcrumbLink href="/">Home</BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbLink href="/proxducts">Products</BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbPage>{product.title}</BreadcrumbPage>
              </BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>
        </div>

        <div class="flex w-full flex-col md:flex-row gap-8">

          <ProductGalery client:only="react" images={galleryImages} />

          <div class="flex flex-col md:max-w-[17.5rem] lg:max-w-[25rem] gap-6 w-full">
            <div class="flex flex-col gap-6">
              <div class="text-heading-2">
                {product.title}
              </div>
              <div class="flex gap-2 md:gap-3 xl:gap-4 items-center">
                {/* TODO Change OriginalAmmount */}
                <Price price={product.price.toFixed(2)} originalPrice={product.price.toFixed(2)} />

              </div>
              <AddToCart
                client:only="react"
                product={product}
              />
              <div class="flex flex-col gap-2">
                <ProductFeature
                  type="DigitalDownload"
                />
                <ProductFeature
                  type="Supplies"
                />
              </div>
              <FileType svg png dxf pdf />
              <Separator />
              <SocialShare
                client:load
                title={product.title}
                imageUrl={galleryImages[0]?.url}
              />
              {relatedProducts.length > 0 && (
                <>
                  <div class="font-bold text-primary">Related Products</div>
                  <RelatedProductsSlider client:load products={relatedProducts} />
                  <Separator />
                </>
              )}
            </div>

            {product.description && (
              <div class="flex flex-col gap-2">
                <div class="font-bold">Description</div>
                <div>
                  <p class="whitespace-pre-wrap">{product.description}</p>
                </div>
              </div>
            )}
          </div>
        </div>
      </MaxWidthContainer>
    )
  }
</Base>
