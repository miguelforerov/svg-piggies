---
import Base from "@/components/store/layout/Base.astro";
import Breadcrumbs from "@/components/store/ui/Breadcrumbs.astro";
import { AddToCart } from "@/components/store/cart/AddToCart";
import ProductGallery from "@/components/store/product/ProductGallery";
import SocialShare from "@/components/store/ui/SocialShare";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import { getProductBySlug } from "@/lib/catalog";

export const prerender = false;

const slug = Astro.params.slug;
let loadError: string | null = null;
let product = null;

if (slug) {
  try {
    product = await getProductBySlug(slug, Astro.request.headers);
  } catch (error) {
    console.error(`Unable to load product ${slug}:`, error);
    loadError = error instanceof Error ? error.message : "Unable to load product";
  }
}

if (!product && !loadError) {
  Astro.response.status = 404;
}

if (loadError) {
  Astro.response.status = 502;
}

const galleryImages = product
  ? product.images.length > 0
    ? product.images.map((image) => ({
        url: image.url,
        altText: product.title,
        width: 800,
        height: 800,
      }))
    : [
        {
          url: "/images/Listing_1_SVG_Piggies_16oz_Christmas_4_Candy_Canes.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/Listing_2_SVG_Piggies_16oz_Christmas_4_Candy_Canes.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/Listing_3_SVG_Piggies_16oz_Christmas_4_Candy_Canes.png",
          altText: product.title,
          width: 800,
          height: 800,
        },
        {
          url: "/images/Listing_4_SVG_Piggies_16oz_Christmas_4_Candy_Canes.jpg",
          altText: product.title,
          width: 800,
          height: 800,
        },
      ]
  : [];


/*
 * TODO(product-detail): hydrate real image metadata once a GET images endpoint
 * exists, and restore related products through a public aggregate endpoint.
 * Sale price and variants remain documented for their future domain support.
 */
---

<Base title={product ? `${product.title} | SVG Piggies` : "Product | SVG Piggies"}>
  {
    loadError ? (
      <section class="section">
        <div class="container text-center">
          <h1 class="h2 mb-4">Product unavailable</h1>
          <p>We could not load this product. Please try again later.</p>
          <a class="btn btn-primary mt-6" href="/products">Back to products</a>
        </div>
      </section>
    ) : !product ? (
      <section class="section">
        <div class="container text-center">
          <h1 class="h2 mb-4">Product not found</h1>
          <p>The requested product does not exist or is not active.</p>
          <a class="btn btn-primary mt-6" href="/products">Back to products</a>
        </div>
      </section>
    ) : (
      <MaxWidthContainer>
        <div class="container pt-6">
          <Breadcrumbs currentLabel={product.title} />
        </div>

        <section class="md:section-sm">
          <div class="container">
            <div class="row justify-center">
              <div class="col-10 md:col-8 lg:col-6">
                <ProductGallery client:only="react" images={galleryImages} />
              </div>

              <div class="col-10 py-6 md:col-8 md:ml-7 lg:col-5 lg:py-0">
                <h1 class="mb-2 text-3xl md:h2 md:mb-6">{product.title}</h1>

                <div class="flex flex-col gap-2">
                  <div class="text-text-gray text-xl line-through">
                    ${product.price.toFixed(2)}
                  </div>
                  <div class="text-text-green text-3xl font-bold">
                    ${product.price.toFixed(2)}
                  </div>
                  {/* TODO(catalog): render sale/compare-at price when supported. */}
                </div>

                {/* TODO(catalog): render variants when supported by Product. */}
                <div class="mt-4 mb-6 flex gap-4">
                  <AddToCart
                    client:only="react"
                    productId={product.id}
                  />
                </div>

                <hr class="my-6 border border-border-main" />

                <div class="mb-6 flex items-center gap-3">
                  <h5 class="max-md:text-base">Share:</h5>
                  <SocialShare
                    client:load
                    title={product.title}
                    imageUrl={galleryImages[0]?.url}
                  />
                </div>
                {product.description && (
                  <section>
                      <h5 class="mb-6">Description</h5>
                    <div class="">
                      <p class="whitespace-pre-wrap">{product.description}</p>
                    </div>
                  </section>
                )}
              </div>
            </div>
          </div>
        </section>
      </MaxWidthContainer>
    )
  }
</Base>
