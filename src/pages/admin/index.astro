---
import Layout from "@/layouts/admin/Layout.astro";
import { Package, Folder, Tags } from "lucide-react";
import { StatsCard } from "@/components/admin/StatsCard";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";

---

<Layout title="Dashboard">
  <MaxWidthLayout>
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Dashboard</h2>
    </div>

    <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <StatsCard
        title="Products"
        value={0}
        icon={Package}
        description="Total products"
      />

      <StatsCard
        title="Collections"
        value={0}
        icon={Folder}
        description="Total collections"
      />

      <StatsCard
        title="Product Types"
        value={0}
        icon={Tags}
        description="Total product types"
      />
    </section>
  </MaxWidthLayout>
</Layout>