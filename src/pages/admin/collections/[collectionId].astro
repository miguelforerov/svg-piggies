---
import Layout from "@/layouts/admin/Layout.astro";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";
import { CollectionShowContainer } from "@/components/admin/CollectionShowContainer";

const { collectionId } = Astro.params;
---

<Layout title="Collection">
  <MaxWidthLayout>
    <div>
      <a
        href="/admin/collections"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Back to Collections
      </a>
    </div>

    <CollectionShowContainer
      collectionId={collectionId ?? ""}
      client:load
    />
  </MaxWidthLayout>
</Layout>
