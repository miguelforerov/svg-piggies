---
import Layout from "@/layouts/admin/Layout.astro";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";
import { ProductTypeShow } from "@/components/admin/product-type/ProductTypeShow";

const { productTypeId } = Astro.params;
---

<Layout title="Product Type">
  <MaxWidthLayout>
    <div>
      <a
        href="/admin/product-types"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Back to Product Types
      </a>
    </div>

    <ProductTypeShow
      productTypeId={productTypeId ?? ""}
      client:load
    />
  </MaxWidthLayout>
</Layout>
