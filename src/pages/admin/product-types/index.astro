---
import Layout from "@/layouts/admin/Layout.astro";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";
import { ProductTypeDialog } from "@/components/admin/product-type/ProductTypeDialog";
import { ProductTypeList } from "@/components/admin/product-type/ProductTypeList";
---

<Layout title="Product Types">
  <MaxWidthLayout>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Product Types</h2>
      <ProductTypeDialog client:load />
    </div>

    <ProductTypeList client:load />
  </MaxWidthLayout>
</Layout>
