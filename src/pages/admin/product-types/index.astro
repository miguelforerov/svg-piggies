---
import Layout from "@/layouts/admin/Layout.astro";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";
import { ProductTypeFormDialog } from "@/components/admin/ProductTypeFormDialog";
import { ProductTypeListContainer } from "@/components/admin/ProductTypeListContainer";
---

<Layout title="Product Types">
  <MaxWidthLayout>
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">Product Types</h2>
      <ProductTypeFormDialog client:load />
    </div>

    <ProductTypeListContainer client:load />
  </MaxWidthLayout>
</Layout>
