---
import Layout from "@/layouts/admin/Layout.astro";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";
import { ProductShow } from "@/components/admin/product/ProductShow";

const { productId } = Astro.params;
---

<Layout title="Product">
  <MaxWidthLayout>
    <div>
      <a
        href="/admin/products"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Back to Products
      </a>
    </div>

    <ProductShow
      productId={productId ?? ""}
      client:load
    />
  </MaxWidthLayout>
</Layout>