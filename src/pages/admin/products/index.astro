---
import Layout from "@/layouts/admin/Layout.astro";
import { ProductListContainer } from "@/components/admin/ProductListContainer";
import { ProductFormDialog } from "@/components/admin/ProductFormDialog";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";

---

<Layout title="Products">
  <MaxWidthLayout>
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Products</h2>
      </div>
      <ProductFormDialog client:load />
    </div>
    <ProductListContainer client:load />
  </MaxWidthLayout>
</Layout>