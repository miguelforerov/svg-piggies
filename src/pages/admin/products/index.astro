---
import Layout from "@/layouts/admin/Layout.astro";
import { Plus } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { ProductListContainer } from "@/components/admin/ProductListContainer";

---

<Layout title="Products">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Products</h2>
        <p class="text-muted-foreground">
          Manage your store products.
        </p>
      </div>
      <a
        href="/admin/products/new"
        class={buttonVariants()}
      >
        <Plus />
        Add Product
      </a>
    </div>
    <ProductListContainer client:load />
  </div>
</Layout>