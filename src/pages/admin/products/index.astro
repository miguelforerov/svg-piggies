---
import Layout from "@/layouts/admin/Layout.astro";
import { ProductList } from "@/components/admin/product/ProductList";
import { ProductDialog } from "@/components/admin/product/ProductDialog";
import MaxWidthLayout from "@/layouts/admin/MaxWidthLayout.astro";

---

<Layout title="Products">
  <MaxWidthLayout>
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Products</h2>
      </div>
      <ProductDialog client:load />
    </div>
    <ProductList client:load />
  </MaxWidthLayout>
</Layout>