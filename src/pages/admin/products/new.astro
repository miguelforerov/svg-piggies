---
import Layout from "@/layouts/admin/Layout.astro";
import { ProductFormContainer } from "@/components/admin/ProductFormContainer";
---

<Layout title="New Product">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">
        New Product
      </h2>

      <p class="text-muted-foreground">
        Create a new product for your store.
      </p>
    </div>

    <div class="max-w-3xl rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
      <ProductFormContainer client:load />
    </div>
  </div>
</Layout>