---
import Base from "@/components/store/layout/Base.astro";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import InfoPageHeader from "@/components/store/ui/InfoPageHeader.astro";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";

---

<Base title="Get In Touch | SVG Piggies">
  <MaxWidthContainer narrow={true}>
      <div class="flex flex-col items-center gap-4 md:gap-6 lg:gap-8 w-full">
        <InfoPageHeader label="contact us" />

        <div class="mb-2 md:mb-5 lg:mb-8 text-center w-full">
          <h1 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] text-center font-bold tracking-tight">
            We'd love to hear from you!
          </h1>
          <p class="mt-3 text lg md:text-xl lg:text-2xl">
            Have a question or need help? <br class="flex md:hidden" /> Send us a message<br class="hidden md:flex" /> and we'll get back to
            you as soon as possible.
          </p>
        </div>

        <form
          method="POST"
          aria-describedby="contact-description"
          class="flex flex-col gap-y-6 w-full bg-muted rounded-[32px] p-[1.25rem] md:p-[2rem] lg:p-[4rem]"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-y-2">
              <label for="first-name" class="flex items-center gap-2 text-lg leading-none font-medium select-none">
                First Name <span aria-hidden="true" class="text-xs text-red-500">*</span>
              </label>
              <Input
                id="first-name"
                name="firstName"
                type="text"
                autoComplete="given-name"
                placeholder="First name"
                className="text-[16px] md:text-[18px]"
                required
              />
            </div>

            <div class="flex flex-col gap-y-2">
              <label for="last-name" class="flex items-center gap-2 text-lg leading-none font-medium select-none">
                Last Name
              </label>
              <Input
                id="last-name"
                name="lastName"
                type="text"
                autoComplete="family-name"
                placeholder="Last name"
                className="text-[16px] md:text-[18px]"
              />
            </div>
          </div>

          <div class="flex flex-col gap-y-2">
            <label for="email" class="flex items-center gap-2 text-lg leading-none font-medium select-none">
              Email <span aria-hidden="true" class="text-xs text-red-500">*</span>
            </label>
            <Input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              inputMode="email"
              placeholder="Email"
              className="text-[16px] md:text-[18px]"
              required
            />
          </div>

          <div class="flex flex-col gap-y-2">
            <label for="message" class="flex items-center gap-2 text-lg leading-none font-medium select-none">
              Message <span aria-hidden="true" class="text-xs text-red-500">*</span>
            </label>
            <Textarea
              id="message"
              name="message"
              minLength={10}
              placeholder="How can we help you?"
              className="text-[16px] md:text-[18px] h-[13rem] md:h-[15rem]"
              required
            />
          </div>

          <div class="flex justify-center">
            <Button className="!px-10">Send</Button>
          </div>
        </form>
      </div>
  </MaxWidthContainer>
</Base>
