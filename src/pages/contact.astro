---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import Button from "@/layouts/shortcodes/Button";
import { Input } from "@/layouts/shortcodes/Input";
import { Textarea } from "@/layouts/shortcodes/Textarea";
import { Label } from "@/components/ui/label";
import MaxWidthContainer from "@/layouts/shortcodes/MaxWidthContainer.astro";

const { contact_form_action: contactFormAction } = config.params;
---

<Base title="Get In Touch | SVG Piggies">
  <MaxWidthContainer>
    <section>
      <div class="flex flex-col items-center gap-[32px]">
        <div class="flex items-center gap-[1rem]">
          <div class="bg-primary h-[1px] w-[124px]"></div>
          <div class="text-2xl font-bold">CONTACT US</div>
          <div class="bg-primary h-[1px] w-[124px]"></div>
        </div>

        <div class="mb-8 text-center w-full">
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            We'd love to hear from you!
          </h1>
          <p id="contact-description" class="mt-3 text-muted-foreground">
            Have a question or need help? Send us a message and we'll get back to
            you as soon as possible.
          </p>
        </div>

        <form
          action={contactFormAction}
          method="POST"
          aria-describedby="contact-description"
          class="flex flex-col gap-y-6 w-full"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-y-2">
              <Label htmlFor="first-name" className="text-lg">
                First Name <span aria-hidden="true" class="text-xs text-red-500">*</span>
              </Label>
              <Input
                id="first-name"
                name="firstName"
                type="text"
                autoComplete="given-name"
                placeholder="First name"
                className="text-[16px] md:text-[18px]"
                required
              />
            </div>

            <div class="flex flex-col gap-y-2">
              <Label htmlFor="last-name" className="text-lg">
                Last Name
              </Label>
              <Input
                id="last-name"
                name="lastName"
                type="text"
                autoComplete="family-name"
                placeholder="Last name"
                className="text-[16px] md:text-[18px]"
              />
            </div>
          </div>

          <div class="flex flex-col gap-y-2">
            <Label htmlFor="email" className="text-lg">
              Email <span aria-hidden="true" class="text-xs text-red-500">*</span>
            </Label>
            <Input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              inputMode="email"
              placeholder="Email"
              className="text-[16px] md:text-[18px]"
              required
            />
          </div>

          <div class="flex flex-col gap-y-2">
            <Label htmlFor="message" className="text-lg">
              Message <span aria-hidden="true" class="text-xs text-red-500">*</span>
            </Label>
            <Textarea
              id="message"
              name="message"
              rows={8}
              minLength={10}
              placeholder="How can we help you?"
              className="text-[16px] md:text-[18px]"
              required
            />
          </div>

          <div class="flex justify-center">
            <Button className="!px-10">Send</Button>
          </div>
        </form>
      </div>
    </section>
  </MaxWidthContainer>
</Base>
