---
import Base from "@/components/layout/Base.astro";
import CollectionsSlider from "@/components/product/CollectionsSlider";
import FeaturedProducts from "@/components/product/FeaturedProducts";
import HeroSlider from "@/components/product/HeroSlider";
import PaginatedProductGrid from "@/components/product/PaginatedProductGrid.astro";
import { getCatalog } from "@/lib/catalog";
import MaxWidthContainer from "@/components/layout/MaxWidthContainer.astro";

let catalogError = false;
let catalog = { products: [], collections: [], productTypes: [] } as Awaited<
  ReturnType<typeof getCatalog>
>;

try {
  catalog = await getCatalog(Astro.request.headers);
} catch (error) {
  console.error("Unable to load the home catalog:", error);
  catalogError = true;
}

const heroProducts = catalog.products.slice(0, 3);
const featuredProducts = catalog.products.slice(0, 8);
const collectionProducts = catalog.collections.map((collection) => ({
  ...collection,
  productCount: catalog.products.filter((product) =>
    product.collections.some((item) => item.id === collection.id),
  ).length,
  // TODO(collection-images): use the collection image once the API supports it.
  imageUrl: undefined,
}));
---

<Base title="SVG Piggies">
  <MaxWidthContainer>
    {
      catalogError && (
        <div class="container pt-6">
          <div class="rounded-md border border-red-300 bg-red-50 p-4 text-red-800">
            The product catalog could not be loaded. Please try again later.
          </div>
        </div>
      )
    }

    {catalog.products.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <div class="row justify-center">
            <PaginatedProductGrid products={catalog.products} />
          </div>
        </div>
      </section>
    )}

    {heroProducts.length > 0 && (
        <section>
          <div class="container">
            <div class="bg-gradient rounded-md py-10">
              <HeroSlider products={heroProducts} client:load />
            </div>
          </div>
        </section>
    )}

    {collectionProducts.length > 0 && (
      <section class="w-full section">
        <div class="container">
          <div class="mb-6 text-center md:mb-14">
            <h2>Collections</h2>
          </div>
          <CollectionsSlider collections={collectionProducts} client:load />
        </div>
      </section>
    )}

    {featuredProducts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="mb-6 text-center md:mb-14">
            <h2 class="mb-2">Featured Products</h2>
          </div>
          <FeaturedProducts products={featuredProducts} client:load />
        </div>
      </section>
    )}
  </MaxWidthContainer>
</Base>
