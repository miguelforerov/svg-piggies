---
interface Props {
  label?: string;
}

const { label } = Astro.props;

---

<div class="flex items-center gap-[1rem]">
  <div class="bg-primary h-[1px] w-[60px] md:w-[124px]"></div>
  <div class="text-heading-4 md:text-heading-3 lg:text-heading-2 font-bold uppercase">{label}</div>
  <div class="bg-primary h-[1px] w-[60px] md:w-[124px]"></div>
</div>