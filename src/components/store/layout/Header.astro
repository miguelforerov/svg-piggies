---
import AccountButton from "@/components/store/navigation/AccountButton";
import SearchBar from "@/components/store/navigation/SearchBar";
import Cart from "@/components/store/icons/Cart";
import { Button } from "@/components/ui/button";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro"
import StoreSidebar from "@/components/store/navigation/Sidebar.astro";

---

<header id="store-header" class="sticky top-0 z-30 flex justify-center bg-white py-0 data-[scrolled]:py-0 md:py-4 md:data-[scrolled]:py-1 shadow-light transition-[padding,box-shadow] duration-300 ease-in-out data-[scrolled]:shadow-sm lg:py-6 lg:data-[scrolled]:py-2">
  <MaxWidthContainer gap="gap-6 md:gap-8">
    <div class="grid grid-cols-2 md:grid-cols-4 w-full items-center gap-8">
      <div class="flex items-center gap-4">
        <a
          id="header-logo"
          href="/"
          class="block h-[5.5rem] w-[5.5rem] md:h-[6.5rem] md:w-[6.5rem] lg:h-[7.5rem] lg:w-[7.5rem] data-[scrolled]:h-[4.5rem] data-[scrolled]:w-[4.5rem] sm:data-[scrolled]:h-[5.5rem] sm:data-[scrolled]:w-[5.5rem] lg:data-[scrolled]:h-[6.5rem] lg:data-[scrolled]:w-[6.5rem] transition-[width,height] duration-500 ease-in-out"
        >
          <img src="/logo.png" alt="SVG Piggies" class="w-full h-full object-contain" />
        </a>
        <StoreSidebar className="hidden md:block" />
      </div>

      <div class="hidden md:flex col-span-2 w-full">
        <SearchBar client:load />
      </div>
      <div class="flex items-center justify-end gap-8">
        <Button
          variant="link"
          size="icon"
          className="w-6 h-6 text-primary">
          <Cart filled className="size-6" />
        </Button>
        <AccountButton client:load />
        <StoreSidebar className="block md:hidden" />
      </div>
    </div>
    <div class="flex md:hidden col-span-2 w-full">
      <SearchBar client:load />
    </div>
  </MaxWidthContainer>
</header>

<script>
  function initializeHeader() {
    const header = document.querySelector("#store-header");
    const logo = document.querySelector("#header-logo");

    function updateNavbarShadow() {
      const scrolled = window.scrollY > 0;
      header?.toggleAttribute("data-scrolled", scrolled);
      logo?.toggleAttribute("data-scrolled", scrolled);
    }

    window.addEventListener("scroll", updateNavbarShadow);
    updateNavbarShadow();

    return () => {
      window.removeEventListener("scroll", updateNavbarShadow);
    };
  }

  initializeHeader();
</script>
