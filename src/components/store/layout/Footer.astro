---
import menu from "@/config/footer-links.json";
import social from "@/config/social.json";
import DynamicIcon from "@/layouts/components/helpers/DynamicIcon";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro"

export interface ISocial {
  name: string;
  icon: string;
  link: string;
}
---

<footer class="flex bg-muted justify-center">
  <MaxWidthContainer gap="gap-0">
    <div class="flex flex-col lg:flex-row w-full items-center py-10">
      <a href="/" class="flex w-[7rem] h-[7rem] shrink-0">
        <img src="/logo.png" alt="SVG Piggies" class="w-full h-full object-contain" />
      </a>

      <div class="flex w-full gap-16">
        <div class="flex flex-col items-start lg:justify-center lg:flex-row w-full gap-4">
          <ul class="flex flex-col lg:text-center md:w-1/3 gap-4">
            {
              menu.footerProducts.map((menu) => (
                <li>
                  <a href={menu.url} class="hover:text-primary duration-300">{menu.name}</a>
                </li>
              ))
            }
          </ul>

          <ul class="flex flex-col lg:text-center md:w-1/3 gap-4">
            {
              menu.footerInfo.map((menu) => (
                <li>
                  <a href={menu.url} class="hover:text-primary duration-300">{menu.name}</a>
                </li>
              ))
            }
          </ul>

          <ul class="flex flex-col lg:text-center md:w-1/3 gap-4">
            {
              menu.footerTerms.map((menu) => (
                <li>
                  <a href={menu.url} class="hover:text-primary duration-300">{menu.name}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col items-center gap-4 flex-auto flex-none">
          <div class="text-md lg:text-lg font-bold">Follow Us</div>
          <ul class="flex flex-col lg:flex-row items-center gap-6 lg:gap-6">
            {
              social.map((social: ISocial) => (
                <li>
                  <a
                    class="flex text-primary justify-center items-center rounded-md hover:bg-primary hover:text-white duration-300 h-10 w-10"
                    aria-label={social.name}
                    href={social.link}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                  >
                    <DynamicIcon
                      aria-hidden="true"
                      focusable="false"
                      className="inline-block h-6 w-6"
                      icon={social.icon}
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div class="flex text-[12px] lg:text-[14px] text-muted-foreground justify-center lg:justify-start w-full">
      © {new Date().getFullYear()} SVG Piggies. All rights reserved.
    </div>
  </MaxWidthContainer>
</footer>
