---
import type { Product } from "@/types/product";
import type { Collection } from "@/types/collection";
import type { ProductType } from "@/types/product-type";
import Pagination from "@/components/store/ui/Pagination.astro";
import ProductFilters from "@/components/store/product/ProductFilters";
import ProductGrid from "@/components/store/product/ProductGrid";
import CatalogResults from "@/components/store/product/CatalogResults";
import { hasActiveCatalogFilters } from "@/lib/catalog-navigation";
import MaxWidthContainer from "@/components/store/layout/MaxWidthContainer.astro";
import ShortBy from "@/components/store/product/ShortBy";
import { TbFilter, TbFilterX } from "react-icons/tb";
import Card from "@/components/store/ui/Card";

type ProductCount = { id: string; productCount: number };

interface Props {
  products: Product[];
  searchValue?: string | null;
  pageSize?: number;
  currentPage?: number;
  totalPages?: number;
  resultsQuery?: string;
  shortBy?: boolean;
  filters?: {
    collections: Collection[];
    productTypes: ProductType[];
    maxPriceData: { amount: string; currencyCode: string };
    collectionCounts: ProductCount[];
    productTypeCounts: ProductCount[];
  };
}

const {
  products, searchValue, pageSize = 12, shortBy, filters,
  currentPage: initialCurrentPage, totalPages: initialTotalPages, resultsQuery,
} = Astro.props;
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const totalPages = initialTotalPages ?? Math.max(1, Math.ceil(products.length / pageSize));
const currentPage = initialCurrentPage ?? Math.min(
  Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1,
  totalPages,
);
const pageStart = (currentPage - 1) * pageSize;
const paginatedProducts = resultsQuery === undefined
  ? products.slice(pageStart, pageStart + pageSize)
  : products;
const selectedNavCollection = Astro.url.searchParams.get("collection");
const allProductsSelected = !selectedNavCollection && !hasActiveCatalogFilters(Astro.url.searchParams);

const collectionLink = (slug?: string) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete("c");
  params.delete("pt");
  if (slug) {
    params.set("collection", slug);
  } else {
    params.delete("collection");
    params.delete("minPrice");
    params.delete("maxPrice");
  }
  params.delete("page");

  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
};
---

<MaxWidthContainer>
  <div class="flex w-full flex-col gap-8 lg:flex-row">
    {filters && (
      <div class="flex flex-col w-full lg:w-[17rem] lg:shrink-0 gap-4">
        {filters && filters.collections.length > 0 && (
          <Card>
            <div class="text-lg font-bold">Collections</div>
            <ul class="flex flex-wrap gap-2">
              <li>
                <a
                  data-catalog-collection=""
                  href={collectionLink()}
                  aria-current={allProductsSelected ? "page" : undefined}
                  class={allProductsSelected ? "font-bold text-text-gray cursor-default" : "font-semibold"}>
                  All products
                </a>
              </li>
              {filters.collections.map((collection) => (
                <li>
                  <a
                    data-catalog-collection={collection.slug}
                    href={collectionLink(collection.slug)}
                    aria-current={selectedNavCollection === collection.slug ? "page" : undefined}
                    class={selectedNavCollection === collection.slug ? "text-text-gray font-bold cursor-default" : ""}>
                    {collection.name}
                  </a>
                </li>
              ))}
            </ul>
          </Card>
        )}
        <div class="flex items-center justify-between lg:hidden">
          <button
            id="catalog-filters-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="catalog-filters-panel"
            class="group flex cursor-pointer items-center gap-2 font-medium"
          >
            Filters
            <TbFilter className="group-aria-expanded:hidden" aria-hidden="true" />
            <TbFilterX className="hidden group-aria-expanded:block" aria-hidden="true" />
          </button>
          <ShortBy client:only="react" />
        </div>
        <aside>
          <ProductFilters
            {...filters}
            toggleId="catalog-filters-toggle"
            panelId="catalog-filters-panel"
            client:only="react"
          />
        </aside>
      </div>
    )}

    <div class="flex flex-col min-w-0 flex-1 gap-8">
      {shortBy && (<div class="hidden lg:block">
        <ShortBy
          client:only="react"
        />
      </div>)}
      {resultsQuery !== undefined ? (
        <CatalogResults
          initialProducts={paginatedProducts}
          initialSearchValue={searchValue ?? ""}
          initialCurrentPage={currentPage}
          initialTotalPages={totalPages}
          initialQuery={resultsQuery}
          client:only="react"
        >
          <div slot="fallback">
            <ProductGrid initialProducts={paginatedProducts} searchValue={searchValue} />
            <div class="my-10">
              <Pagination currentPage={currentPage} totalPages={totalPages} />
            </div>
          </div>
        </CatalogResults>
      ) : (
        <>
          <ProductGrid initialProducts={paginatedProducts} searchValue={searchValue} />
          <div class="my-10">
            <Pagination currentPage={currentPage} totalPages={totalPages} />
          </div>
        </>
      )}
    </div>
  </div>
</MaxWidthContainer>
