---
import "@/styles/main.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";

export interface Props {
  title?: string;
}

const { title = "SVGPiggies" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="SVGPiggies" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex flex-col w-full items-center">
      <slot />
    </main>
    <Footer />
  </body>
</html>