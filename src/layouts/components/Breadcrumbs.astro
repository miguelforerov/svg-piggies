---
import { humanize } from "@/lib/utils/textConverter";

interface Props {
  className?: string;
  currentLabel?: string;
}

const { className, currentLabel } = Astro.props;

const paths = Astro.url.pathname.split("/").filter((x) => x);
const parts = [
  {
    label: "Home",
    href: "/",
    "aria-label": Astro.url.pathname === "/" ? "page" : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  const href = `/${paths.slice(0, i + 1).join("/")}`;
  label !== "page" &&
    parts.push({
      label: humanize(label.replace(".html", "").replace(/[-_]/g, " ")) || "",
      href,
      "aria-label": Astro.url.pathname === href ? "page" : undefined,
    });
});

if (currentLabel && parts.length > 1) {
  parts[parts.length - 1].label = currentLabel;
}
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1 capitalize" role="listitem">
          {index > 0 && <span class="inlin-block mr-1 text-text-gray-light">/</span>}
          {index !== parts.length - 1 ? (
            <a class="text-text-gray-light hover:text-text-gray-light/80" {...attrs}>
              {label}
            </a>
          ) : (
            <span
              aria-current="page"
              class="text-text-gray-light"
            >
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
