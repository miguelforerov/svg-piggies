---
import "@/styles/global.css";
import { Shell } from "@/components/admin/Shell";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — SVG Piggies</title>
  </head>

  <body>
    <Shell title={title} client:load>
      <slot />
    </Shell>
    <main class="p-6">
      <slot />
    </main>
  </body>
</html>