{
  "name": "svg-piggies",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"astro dev\"",
    "build": "node scripts/themeGenerator.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "backend:dev": "cd backend && set -a && . ../.env && set +a && go run ./cmd/api",
    "backend:generate": "cd backend && go generate ./api",
    "backend:test": "cd backend && go test ./...",
    "worker:build": "cd backend && go run github.com/syumai/workers/cmd/workers-assets-gen -mode=go && GOOS=js GOARCH=wasm go build -ldflags='-s -w' -o ./build/app.wasm ./cmd/api",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy --env production",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:create": "docker compose up -d postgres && dbmate --wait migrate && dbmate -e TEST_DATABASE_URL migrate",
    "db:migrate:new": "dbmate new",
    "db:migrate": "dbmate migrate",
    "db:migrate:test": "dbmate -e TEST_DATABASE_URL migrate",
    "db:migrate:rollback": "dbmate rollback",
    "db:migrate:status": "dbmate status"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.4",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nanostores/react": "^1.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "marked": "^18.0.10",
    "nanostores": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.19.1",
    "swiper": "^14.1.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dbmate": "2.35.0",
    "wrangler": "^4.130.0"
  }
}
