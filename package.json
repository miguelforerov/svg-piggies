    "db:migrate": "dbmate migrate",
    "db:migrate:rollback": "dbmate rollback",
    "db:migrate:status": "dbmate status"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "dbmate": "2.35.0"
  }
}
