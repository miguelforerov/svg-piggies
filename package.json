{
  "name": "svg-piggies",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:create": "docker compose up -d postgres && dbmate --wait migrate",
