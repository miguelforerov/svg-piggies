# Local PostgreSQL container. Copy this file to .env before development.
POSTGRES_VERSION="17"
POSTGRES_DB="svg_piggies_development"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

# Storefront configuration. Astro only exposes variables prefixed with PUBLIC_.
PUBLIC_API_BASE_URL="http://localhost:8787"

# Dbmate connects directly to PostgreSQL. Replace this with a direct Neon
# connection string when applying migrations to a Neon development branch.
APP_ENV="development"
AUTH_MODE="development"
DATABASE_NAME="svg_piggies_development"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/svg_piggies_development?sslmode=disable"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/svg_piggies_test?sslmode=disable"

# Wrangler uses this local connection to emulate the HYPERDRIVE binding. It is
# tooling configuration and is not exposed to the Worker runtime.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres:postgres@127.0.0.1:5432/svg_piggies_development?sslmode=disable"

# Dbmate configuration.
DBMATE_MIGRATIONS_DIR="./migrations"
DBMATE_NO_DUMP_SCHEMA="true"
DBMATE_STRICT="true"

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
PRODUCT_FILES_BUCKET=svgpiggies-files-dev
PRODUCT_ASSETS_BUCKET=svgpiggies-assets-dev
