# Local PostgreSQL container. Copy this file to .env before development.
POSTGRES_VERSION="17"
POSTGRES_DB="svg_piggies"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

# Dbmate connects directly to PostgreSQL. Replace this with a direct Neon
# connection string when applying migrations to a Neon development branch.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/svg_piggies?sslmode=disable"

# Dbmate configuration.
DBMATE_MIGRATIONS_DIR="./migrations"
DBMATE_NO_DUMP_SCHEMA="true"
DBMATE_STRICT="true"
