{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svg-piggies-store",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "API",
      "service": "svg-piggies-api"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}